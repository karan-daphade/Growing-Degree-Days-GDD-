# Database Configuration
# Option 1: Full Database URL (Recommended for SQLAlchemy / psycopg2)
DB_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Option 2: Discrete connection parameters
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gdd_model
DB_DRIVER=postgresql+psycopg2

# Optional Pool Settings (for updated.py)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
